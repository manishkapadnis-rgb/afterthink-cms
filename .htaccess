<IfModule mod_rewrite.c>
    RewriteEngine On

    # No RewriteBase: the relative "index.php" target below resolves against the
    # directory that contains this file, so routing works whether the app is at
    # the domain root (production) or in a subfolder (local).

    # Deny direct access to sensitive files
    <FilesMatch "\.(env|ini|log|bak|sql)$">
        Require all denied
    </FilesMatch>
    <FilesMatch "^(config|database)\.php$">
        Require all denied
    </FilesMatch>

    # Do not rewrite existing files or directories
    RewriteCond %{REQUEST_FILENAME} -f [OR]
    RewriteCond %{REQUEST_FILENAME} -d
    RewriteRule ^ - [L]

    # Serve the admin area, assets, uploads, and public files directly
    RewriteRule ^(admin|assets|uploads|public)(/.*)?$ - [L]

    # Front controller: route everything else through index.php
    RewriteRule ^ index.php [QSA,L]
</IfModule>
